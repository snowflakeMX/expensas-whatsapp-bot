# Copiar a .env.local (nunca commitear valores reales)

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
# Número(s) autorizados a usar el bot, separados por coma (formato wa_id, ej: 5491112345678)
WHATSAPP_ALLOWED_NUMBERS=

# --- Google (Gmail + Sheets), OAuth de usuario ---
# El refresh token se genera con: node scripts/google-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Planilla "Expensas 555" (el id está en la URL: /spreadsheets/d/<id>/edit)
EXPENSAS_SHEET_ID=
# Pestaña donde se cargan los meses (por defecto "Hoja 1")
EXPENSAS_SHEET_TAB=

# --- Búsqueda del mail de expensas ---
# Query de Gmail, ej: from:administracion@consorcio.com has:attachment filename:pdf
EXPENSAS_GMAIL_QUERY=

# --- Bot de fútbol (mismo número de WhatsApp) ---
# Production URL del nodo Webhook en n8n, para reenviar todo lo que no sea "verificar expensas"
N8N_FUTBOL_WEBHOOK_URL=
